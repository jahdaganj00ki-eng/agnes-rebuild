# Agnes Sidecar Environment Configuration
# Copy this file to .env and fill in your values

# Required: Agnes AI Gateway API Key
# Register at https://platform.agnes-ai.com/ to get your key
AGNES_API_KEY=your_agnes_api_key_here

# Gateway Base URL (default: international primary)
# Options:
# - https://apihub.agnes-ai.com/v1 (primary international)
# - https://apihub.agnes-ai.cn/v1 (alternate international)
# - https://api.agnes-ai.cn/v1 (China service)
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Video polling base URL (without /v1)
AGNES_POLL_BASE_URL=https://apihub.agnes-ai.com

# Server port
PORT=8080

# Profile: mock | live
# mock: uses in-memory mock store, no gateway calls
# live: proxies requests to Agnes gateway
PROFILE=mock

# Logging level
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:8080

# Mock configuration
MOCK_DELAY_MS=200